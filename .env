# Non-secret build-time config (read by react-native-config; bundled into the app, so NEVER put secrets here).
# Defaults, also used when no .env.<mode> applies. Android picks .env.development for debug builds and
# .env.production for release builds (android/app/build.gradle); iOS maps Debug/Release the same way (ios/Podfile).
PRIVACY_URL=https://jpdash-creator.github.io/fasting-timer-app/POLICY
TERMS_URL=https://jpdash-creator.github.io/fasting-timer-app/TERMS
SUPPORT_EMAIL=jpdash.creator@gmail.com
