{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client",
      "react-native",
      "node"
    ],
    "moduleResolution": "bundler",
    "module": "ESNext",
    "noEmit": true
  },
  "include": [
    "src/**/*",
    "web/**/*",
    "vite.config.mts"
  ]
}
